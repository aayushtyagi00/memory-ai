# Public browser configuration. Leave empty for the explicitly labeled local demo.
# Never put Gemini or service-role secrets in VITE_ variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only (Supabase Edge Function secrets):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Edge secrets: set with `supabase secrets set`.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional email delivery: requires a verified sender and a configured scheduler.
RESEND_API_KEY=
REMINDER_FROM_EMAIL=
# At least 32 random characters, also stored in the scheduler's secret store.
REMINDER_CRON_SECRET=

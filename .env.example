# Frontend variables (Vite)
# Add your Gemini API Key here or enter it directly in the app's Settings page:
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash

# Optional: Supabase backend (leave empty to use local encrypted storage mode)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only (Supabase Edge Function secrets):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
